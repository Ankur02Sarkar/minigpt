   "source": [
   "# minigpt_llm: Serve Locally\n\nBuild and run the Docker image, then hit the OpenAI‑compatible endpoints.\n"]}
,
{
 "cell_type": "code",
 "execution_count": null,
 "metadata": {},
 "outputs": [],
 "source": [
  "# Build the Docker image (one‑time)\n",
 "%%shell\n",
 "cd /opt/minigpt_llm && docker build -t minigpt_llm:0.1.0 .\n",
 "\n",
 "# Run the container\n",
 "%%shell\n",
 "docker run -d \\\n",
 "  --name minigpt-serve \\\n",
 "  -p 8080:8080 \\\n",
 "  -e MINIGPT_API_KEY=sk-minigpt-dev \\\n "  minigpt_llm:0.1.0\n",
 "\n",
 "# Wait for service to start\n",
 "%%shell\n",
 "sleep 5 && curl -s http://localhost:8080/health\n",
 "\n",
 "# OpenAI‑compatible chat completion\n",
 "%%shell\n",
 "curl -s http://localhost:8080/v1/chat/completions \\\n",
 "  -H 'Content-Type: application/json' \\\n",
 "  -H 'Authorization: Bearer sk-minigpt-dev' \\\n",
 "  -d '{\"model\": \"minigpt\", \"messages\": [{\"role\": \"user\", \"content\": \"Hello!\"}], \"max_tokens\": 50}' | python3 -m json.tool"
 ]
}
 ],
