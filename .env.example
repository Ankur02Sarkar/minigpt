# Phase 7 — Environment variables for minigpt_llm
# Copy this file to .env and fill in values before running

# Azure VM & GPU
AZURE_RG=minigpt-rg
AZURE_VM=minigpt-train
AZURE_LOCATION=eastus

# Paths
DATA_ROOT=/data/tokenized
CHECKPOINT_PATH=/opt/minigpt_llm/checkpoints/minigpt-high/best.pt
TOKENIZER_DIR=/opt/minigpt_llm/tokenizer
LOG_DIR=/opt/minigpt_llm/logs

# Serving
MINIGPT_API_MODE=both        # openai | ollama | both
MINIGPT_API_KEY=sk-minigpt-dev  # optional; if set, required for /v1/chat/completions
MINIGPT_HOST=0.0.0.0
MINIGPT_PORT=8080

# Training (if resuming)
TRAIN_CONFIG=configs/minigpt-high.yaml
RESUME=latest

# TensorBoard
TENSORBOARD_PORT=6006
